# Deadlock API key (optional). Sent as the X-API-KEY header.
# Without it requests use the much lower per-IP rate limits.
DEADLOCK_API_KEY=

# Neon Postgres connection string (added automatically by the Vercel Neon integration).
DATABASE_URL=

# Random string, at least 32 characters. Signs the login session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Public URL of the site (used for sitemap / Open Graph). Optional on Vercel.
NEXT_PUBLIC_SITE_URL=
